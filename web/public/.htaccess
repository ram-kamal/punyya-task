<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /task/

  # Do not rewrite physical files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other page requests to index.html
  RewriteRule . index.html [L]
</IfModule>
