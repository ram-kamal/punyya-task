<Application x:Class="PHF.Client.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Punnya Heart Foundation Obsidian-Crimson Design Palette -->
        <SolidColorBrush x:Key="BgCanvas" Color="#0D0E12" />
        <SolidColorBrush x:Key="BgDark" Color="#0A0B0E" />
        <SolidColorBrush x:Key="BgMica" Color="#12141C" />
        <SolidColorBrush x:Key="BgSurface" Color="#151720" />
        <SolidColorBrush x:Key="BgSurfaceCard" Color="#151720" />
        <SolidColorBrush x:Key="BgSurfaceHover" Color="#1C1F2B" />
        <SolidColorBrush x:Key="BgSurfaceLight" Color="#222533" />
        <SolidColorBrush x:Key="BgSurfaceSubtle" Color="#101218" />
        <SolidColorBrush x:Key="BgSurfaceInset" Color="#0D0E12" />

        <!-- Text Colors -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextTertiary" Color="#64748B" />

        <!-- Punnya Heart Foundation Crimson & Rose Accents -->
        <SolidColorBrush x:Key="AccentRose" Color="#E11D48" />
        <SolidColorBrush x:Key="AccentRoseHover" Color="#BE123C" />
        <SolidColorBrush x:Key="AccentRoseLight" Color="#FB7185" />

        <!-- Legacy key aliases so existing references resolve seamlessly to Rose -->
        <SolidColorBrush x:Key="AccentBlue" Color="#E11D48" />
        <SolidColorBrush x:Key="AccentBlueHover" Color="#BE123C" />
        <SolidColorBrush x:Key="AccentBlueLight" Color="#FB7185" />

        <!-- Emerald & Amber Status Indicators -->
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentGreenHover" Color="#059669" />
        <SolidColorBrush x:Key="AccentGreenSoft" Color="#34D399" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentAmberHover" Color="#D97706" />
        <SolidColorBrush x:Key="AccentRed" Color="#E11D48" />
        <SolidColorBrush x:Key="AccentRedHover" Color="#F43F5E" />

        <!-- Borders -->
        <SolidColorBrush x:Key="BorderSubtle" Color="#262938" />
        <SolidColorBrush x:Key="BorderSubtleHover" Color="#383C50" />
        <SolidColorBrush x:Key="BorderFocus" Color="#E11D48" />

        <!-- Global Font Family -->
        <FontFamily x:Key="FluentFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>

        <!-- Accessible Focus Visual Style -->
        <Style x:Key="AccessibleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Stroke="#E11D48" StrokeThickness="2" StrokeDashArray="2 2" SnapsToDevicePixels="true" RadiusX="4" RadiusY="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Punnya Heart Primary Button Style -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FluentFont}" />
            <Setter Property="Background" Value="{StaticResource AccentRose}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#00000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92" />
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRoseHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1C1F2B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#262938" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outline Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BgSurfaceHover}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262938" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderSubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#101218" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 / Punnya Heart TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource FluentFont}" />
            <Setter Property="Background" Value="{StaticResource BgSurfaceInset}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentRoseLight}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderSubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderFocus}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 / Punnya Heart PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource FluentFont}" />
            <Setter Property="Background" Value="{StaticResource BgSurfaceInset}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentRoseLight}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderSubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderFocus}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
