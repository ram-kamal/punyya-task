<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PHF.Client.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        
        <!-- Apple & Fluent Glass Button Styles -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#E11D48" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F43F5E" />
        </Style>

        <Style Selector="Button.glass">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderBrush" Value="#2C2C2E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.glass:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="BorderBrush" Value="#38383A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.accentGreen">
            <Setter Property="Background" Value="#34C759" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.accentGreen:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#30B74F" />
        </Style>

        <Style Selector="Button.accentRed">
            <Setter Property="Background" Value="#FF3B30" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.accentRed:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E03228" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#2A1215" />
            <Setter Property="Foreground" Value="#FF453A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderBrush" Value="#50FF3B30" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3B30" />
            <Setter Property="BorderBrush" Value="#FF3B30" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- macOS Traffic Light Button Styles -->
        <Style Selector="Button.macTrafficBtn">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.macTrafficBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <!-- Windows / Fluent Titlebar Caption Buttons -->
        <Style Selector="Button.titleBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.titleBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF" />
        </Style>

        <Style Selector="Button.titleBtnClose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.titleBtnClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3B30" />
        </Style>
        <Style Selector="Button.titleBtnClose:pointerover TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Modern Apple Dark Glass TextBoxes -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#161617" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#2C2C2E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Arial, sans-serif" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#2997FF" />
            <Setter Property="Background" Value="#1C1C1E" />
        </Style>

        <!-- Modern Apple Dark ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#161617" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#2C2C2E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Arial, sans-serif" />
        </Style>
        <Style Selector="ComboBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#2997FF" />
        </Style>

        <!-- Apple Segmented Navigation Tab Buttons -->
        <Style Selector="Button.tabBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#86868B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Arial, sans-serif" />
        </Style>
        <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="Foreground" Value="#F5F5F7" />
        </Style>
        <Style Selector="Button.tabBtnActive">
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderBrush" Value="#424245" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Arial, sans-serif" />
        </Style>
        <Style Selector="Button.tabBtnActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Clean Translucent ScrollBars -->
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="ScrollBar:pointerover">
            <Setter Property="Opacity" Value="0.95" />
        </Style>
    </Application.Styles>
</Application>