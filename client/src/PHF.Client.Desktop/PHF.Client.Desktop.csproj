<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>PunnyaHeartDesk</AssemblyName>
    <AssemblyTitle>Punnya Heart Desk</AssemblyTitle>
    <Product>Punnya Heart Foundation Work Management System</Product>
    <Company>Punnya Heart Foundation</Company>
    <Description>Workstation Telemetry and Task Desk for macOS and Windows</Description>
    <Version>1.0.0-beta</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PHF.Client.Core\PHF.Client.Core.csproj" />
    <ProjectReference Include="..\PHF.Client.Telemetry\PHF.Client.Telemetry.csproj" />
    <ProjectReference Include="..\..\..\backend\src\PHF.Core\PHF.Core.csproj" />
  </ItemGroup>

</Project>
