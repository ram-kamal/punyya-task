<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PHF.Client.Desktop.ViewModels"
        x:Class="PHF.Client.Desktop.MainWindow"
        Title="Punnya Heart Desk — Workstation Desk &amp; Management Console"
        Width="1180" Height="860"
        MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica,AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="46">

    <Grid>
        <!-- macOS / Windows Frosted Glass Acrylic Background -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    TintColor="#0D0E14"
                    TintOpacity="0.88"
                    MaterialOpacity="0.65" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <!-- Ambient Golden Gate Glows -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="450" Height="250" Canvas.Top="-80" Canvas.Left="200" Fill="#12E11D48" />
            <Ellipse Width="350" Height="200" Canvas.Top="200" Canvas.Right="100" Fill="#0D6366F1" />
        </Canvas>

        <!-- Main Window Layout -->
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            
            <!-- Top Header Bar -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="#22151722"
                    BorderBrush="#25FFFFFF"
                    BorderThickness="0,0,0,1"
                    Padding="16,8,12,8"
                    PointerPressed="TitleBar_PointerPressed"
                    DoubleTapped="TitleBar_DoubleTapped">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    
                    <!-- Left: Traffic Lights + App Emblem + Organization Info -->
                    <StackPanel x:Name="HeaderLeftStack" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- macOS Traffic Lights (Visible only on macOS) -->
                        <StackPanel x:Name="MacTrafficLightsStack" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0" IsVisible="False">
                            <Button Classes="macTrafficBtn" Background="#FF5F56" BorderBrush="#E0443E" ToolTip.Tip="Close" Click="MacClose_Click" />
                            <Button Classes="macTrafficBtn" Background="#FFBD2E" BorderBrush="#DEA123" ToolTip.Tip="Minimize" Click="MacMinimize_Click" />
                            <Button Classes="macTrafficBtn" Background="#27C93F" BorderBrush="#1AAB29" ToolTip.Tip="Maximize" Click="MacMaximize_Click" />
                        </StackPanel>

                        <!-- App Emblem -->
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#E11D48" Offset="0" />
                                    <GradientStop Color="#BE123C" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="♥" FontSize="17" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Punnya Heart Desk" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                                <Border Background="#20E11D48" BorderBrush="#40E11D48" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock x:Name="TxtPlatformEdition" Text="Windows 11 Mica" FontSize="10" FontWeight="Bold" Foreground="#FDA4AF" />
                                </Border>

                                <!-- Role Badge -->
                                <Border x:Name="RoleBadgeBorder" Background="#206366F1" BorderBrush="#406366F1" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" IsVisible="False">
                                    <TextBlock x:Name="TxtUserRoleBadge" Text="ADMIN" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" />
                                </Border>

                                <!-- Live SignalR Badge -->
                                <Border x:Name="StatusBadgeBorder" Background="#2010B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtConnectionStatus" Text="LIVE CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Punnya Heart Foundation • Workstation Telemetry &amp; Workforce Management" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: User Station Profile + Sign Out -->
                    <StackPanel x:Name="HeaderRightStack" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock x:Name="TxtUserInfo" Text="Workstation Desk" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnLogout" Classes="glass" Content="Sign Out" Margin="8,0,0,0" Click="BtnLogout_Click" />
                    </StackPanel>

                    <!-- Windows Fluent Caption Buttons -->
                    <StackPanel x:Name="WindowsCaptionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="4">
                        <Button x:Name="BtnTitleMinimize" Classes="titleBtn" ToolTip.Tip="Minimize" Click="BtnTitleMinimize_Click">
                            <TextBlock Text="─" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="BtnTitleMaximize" Classes="titleBtn" ToolTip.Tip="Maximize / Restore" Click="BtnTitleMaximize_Click">
                            <TextBlock x:Name="TxtMaximizeIcon" Text="□" FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="BtnTitleClose" Classes="titleBtnClose" ToolTip.Tip="Close" Click="BtnTitleClose_Click">
                            <TextBlock Text="✕" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Admin / Manager Navigation Bar -->
            <Border x:Name="AdminNavBarBorder" Grid.Row="1" Background="#18131A26" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="20,6" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="BtnTabMyDesk" Classes="tabBtnActive" Content="💻 My Desk &amp; Shift" Click="BtnTabMyDesk_Click" />
                        <Button x:Name="BtnTabWorkforce" Classes="tabBtn" Content="🖥️ Workforce Fleet" Click="BtnTabWorkforce_Click" />
                        <Button x:Name="BtnTabTasks" Classes="tabBtn" Content="📋 Task Dispatch" Click="BtnTabTasks_Click" />
                        <Button x:Name="BtnTabTimesheets" Classes="tabBtn" Content="⏱️ Timesheets" Click="BtnTabTimesheets_Click" />
                        <Button x:Name="BtnTabLeaves" Classes="tabBtn" Content="🏖️ Leave Approvals" Click="BtnTabLeaves_Click" />
                        <Button x:Name="BtnTabStaff" Classes="tabBtn" Content="👥 Staff Directory" Click="BtnTabStaff_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnAdminDispatchQuick" Classes="primary" Content="+ Dispatch Task" Click="BtnOpenDispatchModal_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area Views Container -->
            <Grid Grid.Row="2">
                
                <!-- 1. VIEW: MY DESK & PERSONAL SHIFT (Accessible by both Employees & Admins) -->
                <Grid x:Name="ViewMyDesk" Margin="24,18,24,12" RowDefinitions="Auto,Auto,*" IsVisible="True">
                    
                    <!-- Overview Cards (Shift & Telemetry) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,16,*" Margin="0,0,0,16">
                        
                        <!-- Shift Management Glass Card -->
                        <Border Grid.Column="0" Background="#25161A26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="18,14">
                            <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="SHIFT MANAGEMENT" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtShiftState" Text="Clocked Out" FontSize="17" FontWeight="Bold" Foreground="#F59E0B" />
                                        <Border x:Name="ShiftClockBadge" Background="#2038BDF8" BorderBrush="#3538BDF8" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" IsVisible="False">
                                            <TextBlock x:Name="TxtShiftDigitalClock" Text="00:00:00" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas,Cascadia Code,Segoe UI,monospace" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtShiftHours" Text="Logged Today: --" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="BtnClockToggle" Grid.Row="1" Grid.Column="1" Classes="accentGreen" Content="Clock In" VerticalAlignment="Center" Click="BtnClockToggle_Click" />
                            </Grid>
                        </Border>

                        <!-- Workstation Telemetry Glass Card -->
                        <Border Grid.Column="2" Background="#25161A26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="18,14">
                            <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="WORKSTATION TELEMETRY" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                                <Border Grid.Row="0" Grid.Column="1" Background="#20E11D48" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Active Monitoring Hook" FontSize="10" FontWeight="SemiBold" Foreground="#FB7185" />
                                </Border>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTelemetryHook" Text="Win32 &amp; System Hook" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtActiveApp" Text="Active App: Ready" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Row="1" Grid.Column="1" Background="#2010B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtActiveTaskBadge" Text="No task linked" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Toolbar & Actions -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="My Assigned Tasks" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            <TextBlock Text="• Review deliverables &amp; work progress" FontSize="12" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnOpenLeaveCenter" Classes="glass" Content="🏖️ Leaves" Click="BtnOpenLeaveCenter_Click" />
                            <Button x:Name="BtnSyncNow" Classes="glass" Content="Sync Telemetry" Click="BtnSyncNow_Click" />
                            <Button x:Name="BtnRefresh" Classes="glass" Content="↻ Refresh" Click="BtnRefresh_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Tasks Scrollable Feed -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TasksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <Border Background="#25161A26" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                            
                                            <!-- Top Row: Task Code + Title -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#25E11D48" BorderBrush="#40E11D48" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TaskCode}" FontSize="11" FontWeight="Bold" Foreground="#FB7185" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Priority Badge -->
                                            <Border Grid.Row="0" Grid.Column="1" Background="{Binding PriorityBgBrush}" CornerRadius="8" Padding="8,2">
                                                <TextBlock Text="{Binding Priority}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding PriorityFgBrush}" />
                                            </Border>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Description}" 
                                                       FontSize="12" Foreground="#94A3B8" Margin="0,6,0,10" TextWrapping="Wrap" />

                                            <!-- Status & Deliverable Gate Ribbon -->
                                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#1A000000" 
                                                    BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Background="{Binding StatusBgBrush}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColorBrush}" />
                                                    </Border>
                                                    <Border Grid.Column="2" Background="{Binding DeliverableBgBrush}" CornerRadius="4" Padding="8,2">
                                                        <TextBlock Text="{Binding DeliverableStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding DeliverableColorBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Actions Row -->
                                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                                                        IsVisible="{Binding IsActionButtonsVisible}">
                                                <Button Content="{Binding StartPauseButtonText}" Background="{Binding StartPauseButtonBrush}" 
                                                        Foreground="#FFFFFF" CornerRadius="6" Padding="12,6" Tag="{Binding Id}" Click="BtnStartPauseTask_Click" />
                                                <Button Classes="glass" Content="🔗 View Deliverable" IsVisible="{Binding HasDeliverable}" Padding="12,6" Tag="{Binding Id}" Click="BtnViewDeliverable_Click" />
                                                <Button Classes="glass" Content="Attach Deliverable" Padding="12,6" Tag="{Binding Id}" Click="BtnAttachDeliverable_Click" />
                                                <Button Classes="accentGreen" Content="Mark Completed ✓" IsEnabled="{Binding CanComplete}" 
                                                        Padding="12,6" Tag="{Binding Id}" Click="BtnMarkCompleted_Click" />
                                            </StackPanel>

                                            <!-- Completed State Banner -->
                                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                                                        IsVisible="{Binding IsCompletedBadgeVisible}">
                                                <Button Classes="glass" Content="🔗 View Deliverable" IsVisible="{Binding HasDeliverable}" Padding="10,4" Tag="{Binding Id}" Click="BtnViewDeliverable_Click" />
                                                <Border Background="#2010B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                    <TextBlock Text="✓ Task Completed &amp; Archived" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 2. VIEW: TEAM WORKFORCE FLEET (Live Workstations) -->
                <Grid x:Name="ViewWorkforce" Margin="24,18,24,12" RowDefinitions="Auto,Auto,*" IsVisible="False">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Live Workforce Fleet Telemetry" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Real-time monitoring of active workstations, desktop focus &amp; idle metrics" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="glass" Content="↻ Refresh Fleet" Click="BtnRefreshWorkforce_Click" />
                    </Grid>

                    <!-- Fleet Quick KPI Cards -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,12,*,12,*" Margin="0,0,0,16">
                        <Border Grid.Column="0" Background="#20161A26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="ACTIVE STATIONS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtFleetActiveCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#20161A26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="IDLE STATIONS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtFleetIdleCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="#20161A26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="OFFLINE / REGISTERED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtFleetTotalCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Workstations Cards List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="WorkforceItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AdminWorkstationItemViewModel">
                                    <Border Background="#25161A26" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                            
                                            <!-- Top row: Station ID + User Full Name + State Badge -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StateDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StationId}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                <TextBlock Text="—" FontSize="12" Foreground="#64748B" Margin="6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UserFullName}" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- State Ribbon Badge -->
                                            <Border Grid.Row="0" Grid.Column="1" Background="{Binding StateBgBrush}" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding State}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StateFgBrush}" />
                                            </Border>

                                            <!-- Middle row: Active App + Window Title -->
                                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#14000000" CornerRadius="6" Padding="12,8" Margin="0,10,0,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding ActiveAppName}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" />
                                                        <TextBlock Text="{Binding WindowTitle}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding IdleText}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- Bottom row: Active Task + Last Seen -->
                                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding TaskDisplayText}" FontSize="11" Foreground="#34D399" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding LastSeenText, StringFormat='Last Seen: {0}'}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 3. VIEW: TASK DISPATCH & WORKFORCE BOARD -->
                <Grid x:Name="ViewTaskDispatch" Margin="24,18,24,12" RowDefinitions="Auto,Auto,*" IsVisible="False">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Workforce Task Dispatch &amp; Review" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Assign tasks to employees, inspect deliverables and track active work streams" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" Content="+ Dispatch Task" Click="BtnOpenDispatchModal_Click" />
                            <Button Classes="glass" Content="↻ Refresh Tasks" Click="BtnRefreshAllTasks_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Filter Row -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtAdminTasksCount" Text="All Workforce Tasks (0 total)" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Tasks Items List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AllTasksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AdminTaskItemViewModel">
                                    <Border Background="#25161A26" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                            
                                            <!-- Top row: Task code, Title, Assignee, Priority -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#25E11D48" BorderBrush="#40E11D48" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TaskCode}" FontSize="11" FontWeight="Bold" Foreground="#FB7185" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                <Border Background="#20FFFFFF" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding AssigneeName, StringFormat='Assignee: {0}'}" FontSize="10.5" Foreground="#CBD5E1" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Priority & Status Badges -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Border Background="{Binding PriorityBgBrush}" CornerRadius="6" Padding="8,2">
                                                    <TextBlock Text="{Binding Priority}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding PriorityFgBrush}" />
                                                </Border>
                                                <Border Background="{Binding StatusBgBrush}" CornerRadius="6" Padding="8,2">
                                                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusFgBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Description}" 
                                                       FontSize="12" Foreground="#94A3B8" Margin="0,8,0,10" TextWrapping="Wrap" />

                                            <!-- Bottom Row: Deliverable Inspector & Time Tracked -->
                                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border IsVisible="{Binding HasDeliverable}" Background="#2510B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="✓ Deliverable:" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" />
                                                            <TextBlock Text="{Binding DeliverableName}" FontSize="10.5" Foreground="#A7F3D0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Classes="glass" Content="🔗 View Deliverable" IsVisible="{Binding HasDeliverable}" Padding="8,3" Tag="{Binding Id}" Click="BtnViewDeliverable_Click" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding TrackedTimeText, StringFormat='Tracked: {0}'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 4. VIEW: TIMESHEETS & PRODUCTIVITY -->
                <Grid x:Name="ViewTimesheets" Margin="24,18,24,12" RowDefinitions="Auto,Auto,Auto,*" IsVisible="False">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Workforce Timesheets &amp; Efficiency KPIs" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Itemized employee work shifts, active focus scoring, and automated compliance" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="accentGreen" Content="⬇ Export CSV" Click="BtnExportTimesheetCsv_Click" />
                            <Button Classes="glass" Content="↻ Refresh Timesheet" Click="BtnRefreshTimesheet_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- KPI Cards -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,12,*,12,*,12,*" Margin="0,0,0,16">
                        <Border Grid.Column="0" Background="#20161A26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="ACTIVE STATIONS" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtTsActiveStations" Text="0" FontSize="18" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#20161A26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="TOTAL HOURS TODAY" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtTsTotalHours" Text="0.0h" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="#20161A26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="AVG FOCUS SCORE" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtTsAvgFocus" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Background="#20161A26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="TASKS IN PROGRESS" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtTsActiveTasks" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FB7185" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Timesheet Table Header -->
                    <Border Grid.Row="2" Background="#18FFFFFF" CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="110,180,130,90,90,80,80,80,*">
                            <TextBlock Grid.Column="0" Text="DATE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="1" Text="EMPLOYEE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="2" Text="STATION" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="3" Text="CLOCK IN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="4" Text="CLOCK OUT" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="5" Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="6" Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="7" Text="FOCUS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="8" Text="TASKS DONE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                        </Grid>
                    </Border>

                    <!-- Timesheet Table Rows -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TimesheetsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AdminTimesheetRowViewModel">
                                    <Border Background="#20161A26" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="110,180,130,90,90,80,80,80,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Date}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserFullName}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                <TextBlock Text="{Binding UserEmail}" FontSize="10" Foreground="#64748B" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StationId}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding ClockInText}" FontSize="11" Foreground="#34D399" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding ClockOutText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding TotalHoursText}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding ActiveHoursText}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="7" Text="{Binding FocusScoreText}" FontSize="12" FontWeight="Bold" Foreground="{Binding FocusColorBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="8" Text="{Binding TasksCompletedText}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 5. VIEW: LEAVE APPROVALS -->
                <Grid x:Name="ViewLeaveApprovals" Margin="24,18,24,12" RowDefinitions="Auto,*" IsVisible="False">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Employee Leave Approvals" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Review employee time-off requests, provide manager comments, and update status" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="glass" Content="↻ Refresh Leaves" Click="BtnRefreshAdminLeaves_Click" />
                    </Grid>

                    <!-- Leaves Scrollable List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LeaveApprovalsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AdminLeaveApprovalViewModel">
                                    <Border Background="#25161A26" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                            
                                            <!-- Top row: Employee Name + Leave Type Badge -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UserEmail, StringFormat='({0})'}" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <Border Background="#25E11D48" BorderBrush="#40E11D48" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding LeaveType}" FontSize="10.5" FontWeight="Bold" Foreground="#FB7185" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Row="0" Grid.Column="1" Background="{Binding StatusBgBrush}" CornerRadius="6" Padding="8,2">
                                                <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusFgBrush}" />
                                            </Border>

                                            <!-- Middle: Dates & Reason -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,10">
                                                <TextBlock Text="{Binding DateRangeText, StringFormat='📅 Duration: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                <TextBlock Text="{Binding Reason, StringFormat='Reason: {0}'}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ReviewInfo}" FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- Bottom Actions (Approve / Reject) -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                                                        IsVisible="{Binding IsPending}">
                                                <Button Classes="glass" Content="✕ Reject" Foreground="#F87171" Tag="{Binding Id}" Click="BtnRejectLeave_Click" />
                                                <Button Classes="accentGreen" Content="✓ Approve Leave" Tag="{Binding Id}" Click="BtnApproveLeave_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 6. VIEW: STAFF DIRECTORY -->
                <Grid x:Name="ViewStaffDirectory" Margin="24,18,24,12" RowDefinitions="Auto,*" IsVisible="False">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Staff &amp; Workforce Directory" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Registered team members, authorization roles, work modes, and active stations" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" Content="+ Add Staff Member" Click="BtnOpenAddStaffModal_Click" />
                            <Button Classes="glass" Content="↻ Refresh Staff" Click="BtnRefreshStaff_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Staff Cards Grid/List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StaffItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AdminStaffMemberViewModel">
                                    <Border Background="#25161A26" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                            
                                            <!-- Left: Name, Email, Station -->
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                                                    <Border Background="{Binding RoleBadgeBrush}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold" Foreground="{Binding RoleFgBrush}" />
                                                    </Border>
                                                    <Border Background="#15FFFFFF" CornerRadius="6" Padding="6,2" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding WorkMode}" FontSize="10" Foreground="#CBD5E1" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- Right: Shift State Badge -->
                                            <Border Grid.Row="0" Grid.Column="1" Background="#15000000" CornerRadius="6" Padding="8,4">
                                                <TextBlock Text="{Binding ShiftStatus}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ShiftStatusBrush}" />
                                            </Border>

                                            <!-- Bottom Info -->
                                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                                <TextBlock Grid.Column="0" Text="{Binding StationId, StringFormat='Paired Station: {0}'}" FontSize="11" Foreground="#64748B" />
                                                <TextBlock Grid.Column="1" Text="{Binding ActiveTasksCount, StringFormat='Active Tasks: {0}'}" FontSize="11" Foreground="#38BDF8" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="3" Background="#20151722" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="20,6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="TxtStatusBar" Text="Workstation Active • Telemetry Ready" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="TxtSyncInfo" Grid.Column="1" Text="Local Buffer: Synced" FontSize="11" Foreground="#34D399" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODALS & DIALOGS ================= -->

        <!-- Glass Modal Dialog: Attach Deliverable -->
        <Grid x:Name="AttachDeliverableModal" IsVisible="False" Background="#B3000000">
            <Border Background="#E6161A26" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14" Width="480" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Attach Proof of Work / Deliverable" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Deliverable Gate: Proof of output is required to mark task complete." FontSize="11.5" Foreground="#94A3B8" />

                    <Border Background="#1A000000" BorderBrush="#50E11D48" BorderThickness="1.5" CornerRadius="8" Height="90" Padding="14">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="📁 Select Local File or Enter Link Below" FontSize="13" FontWeight="SemiBold" Foreground="#FB7185" HorizontalAlignment="Center" />
                            <TextBlock Text="ZIP, PDF, DOCX, MP4, code, screenshots, etc." FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnBrowseFile" Classes="glass" Content="Browse Local File..." HorizontalAlignment="Stretch" Click="BtnBrowseFile_Click" />
                    <TextBlock x:Name="TxtSelectedFilePath" Text="No file selected" FontSize="11" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="Or External Deliverable Link / URL (Google Drive, GitHub, etc.):" FontSize="11" Foreground="#94A3B8" />
                    <TextBox x:Name="TxtDeliverableUrlInput" Watermark="https://drive.google.com/..." />

                    <Grid ColumnDefinitions="*,10,*" Margin="0,10,0,0">
                        <Button Grid.Column="0" Classes="glass" Content="Cancel" HorizontalAlignment="Stretch" Click="BtnCancelDeliverable_Click" />
                        <Button Grid.Column="2" Classes="accentGreen" Content="Attach ✓" HorizontalAlignment="Stretch" Click="BtnSaveDeliverable_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Glass Modal Dialog: Employee Sign In -->
        <Grid x:Name="LoginModal" IsVisible="False" Background="#CC000000">
            <Border Background="#F0141722" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Width="420" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <Border Width="42" Height="42" CornerRadius="12" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#E11D48" Offset="0" />
                                <GradientStop Color="#BE123C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="♥" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Punnya Heart Desk" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                    <TextBlock Text="Sign in to your workstation to log shift &amp; tasks" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Username or Email" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtLoginEmail" Watermark="employee@punnya.org" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Password" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtLoginPassword" PasswordChar="•" />
                    </StackPanel>

                    <!-- Remember Credentials Option -->
                    <CheckBox x:Name="ChkRememberCredentials" Content="Remember Employee ID &amp; Password" IsChecked="True" Foreground="#CBD5E1" FontSize="11" Margin="2,0,0,0" />

                    <Border Background="#2010B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel Spacing="4">
                            <CheckBox x:Name="ChkWorkFromHome" Content="Working from Home / Remote Station" IsChecked="False" />
                            <TextBlock x:Name="TxtDevicePreview" Text="Paired Device: ST-STATION" FontSize="10.5" Foreground="#34D399" Margin="24,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Advanced Network Setting -->
                    <Expander Header="⚙ Advanced Connection (Optional)" FontSize="11" Foreground="#94A3B8">
                        <StackPanel Spacing="6" Margin="4,6,4,0">
                            <TextBlock Text="Server API URL" FontSize="10" Foreground="#94A3B8" />
                            <TextBox x:Name="TxtServerUrl" Text="https://punnya-api.onrender.com" FontSize="11" />
                            <TextBlock Text="Station Identifier" FontSize="10" Foreground="#94A3B8" />
                            <TextBox x:Name="TxtLoginStation" Text="WFH-MAC" FontSize="11" />
                        </StackPanel>
                    </Expander>

                    <TextBlock x:Name="TxtLoginError" Text="" FontSize="11" Foreground="#EF4444" IsVisible="False" />

                    <Button x:Name="BtnDoLogin" Classes="primary" Content="Clock In &amp; Launch Desk" Height="36" HorizontalAlignment="Stretch" Click="BtnDoLogin_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Glass Modal Dialog: Personal Leave Center -->
        <Grid x:Name="LeaveCenterModal" IsVisible="False" Background="#B3000000">
            <Border Background="#F0141722" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14" Width="660" MaxHeight="600" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Employee Leave Center" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Apply for time-off and track management review status" FontSize="11.5" Foreground="#94A3B8" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="glass" Content="✕" Padding="8,4" Click="BtnCloseLeaveCenter_Click" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="280,14,*">
                        <!-- Left: Apply Form -->
                        <Border Grid.Column="0" Background="#1A000000" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="APPLY FOR LEAVE" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                                
                                <TextBlock Text="Leave Type" FontSize="11" Foreground="#94A3B8" />
                                <ComboBox x:Name="CmbLeaveType" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="CASUAL — Casual Leave" Tag="CASUAL" />
                                    <ComboBoxItem Content="SICK — Sick Leave" Tag="SICK" />
                                    <ComboBoxItem Content="MEDICAL — Medical Leave" Tag="MEDICAL" />
                                    <ComboBoxItem Content="ANNUAL — Annual Leave" Tag="ANNUAL" />
                                    <ComboBoxItem Content="EMERGENCY — Emergency" Tag="EMERGENCY" />
                                </ComboBox>

                                <TextBlock Text="Start Date (YYYY-MM-DD)" FontSize="11" Foreground="#94A3B8" />
                                <TextBox x:Name="TxtLeaveStartDate" />

                                <TextBlock Text="End Date (YYYY-MM-DD)" FontSize="11" Foreground="#94A3B8" />
                                <TextBox x:Name="TxtLeaveEndDate" />

                                <TextBlock Text="Reason / Justification" FontSize="11" Foreground="#94A3B8" />
                                <TextBox x:Name="TxtLeaveReason" Height="50" AcceptsReturn="True" TextWrapping="Wrap" />

                                <TextBlock x:Name="TxtLeaveFormMessage" Text="" FontSize="10.5" Foreground="#34D399" IsVisible="False" />
                                <Button x:Name="BtnSubmitLeaveApplication" Classes="primary" Content="Submit Application ✓" HorizontalAlignment="Stretch" Click="BtnSubmitLeaveApplication_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Right: Leave History -->
                        <Border Grid.Column="2" Background="#1A000000" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Text="MY SUBMITTED REQUESTS" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="glass" Content="↻" Padding="6,2" Click="BtnRefreshLeaves_Click" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LeavesItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LeaveItemViewModel">
                                                <Border Background="#25161A26" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel Spacing="3">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding LeaveType}" FontSize="11.5" FontWeight="Bold" Foreground="#FB7185" />
                                                            <Border Grid.Column="1" Background="{Binding StatusBgBrush}" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusFgBrush}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding DateRangeText}" FontSize="11" Foreground="#F8FAFC" />
                                                        <TextBlock Text="{Binding Reason}" FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                        <Border IsVisible="{Binding HasReview}" Background="#15000000" CornerRadius="4" Padding="4" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding ReviewText}" FontSize="10" Foreground="#34D399" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Glass Modal Dialog: Dispatch New Task (Admin) -->
        <Grid x:Name="DispatchTaskModal" IsVisible="False" Background="#CC000000">
            <Border Background="#F0141722" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14" Width="480" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Dispatch New Workforce Task" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Create a new task and assign to a team member or leave in pool" FontSize="11.5" Foreground="#94A3B8" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Task Title" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtDispatchTitle" Watermark="e.g. Audit Telemetry Stream Baseline" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Task Description" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtDispatchDescription" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Watermark="Detailed instructions..." />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Assignee" FontSize="11" Foreground="#94A3B8" />
                            <ComboBox x:Name="CmbDispatchAssignee" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Priority" FontSize="11" Foreground="#94A3B8" />
                            <ComboBox x:Name="CmbDispatchPriority" SelectedIndex="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="LOW" Tag="LOW" />
                                <ComboBoxItem Content="MEDIUM" Tag="MEDIUM" />
                                <ComboBoxItem Content="HIGH" Tag="HIGH" />
                                <ComboBoxItem Content="CRITICAL" Tag="CRITICAL" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Due Date (Optional YYYY-MM-DD)" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtDispatchDueDate" Watermark="2026-10-10" />
                    </StackPanel>

                    <CheckBox x:Name="ChkDispatchDeliverableRequired" Content="Proof of Work Deliverable Required to Close" IsChecked="True" Foreground="#CBD5E1" FontSize="11" Margin="2,4,0,0" />

                    <TextBlock x:Name="TxtDispatchError" Text="" FontSize="11" Foreground="#EF4444" IsVisible="False" />

                    <Grid ColumnDefinitions="*,10,*" Margin="0,10,0,0">
                        <Button Grid.Column="0" Classes="glass" Content="Cancel" HorizontalAlignment="Stretch" Click="BtnCancelDispatch_Click" />
                        <Button Grid.Column="2" Classes="primary" Content="Dispatch Task 🚀" HorizontalAlignment="Stretch" Click="BtnSubmitDispatch_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Glass Modal Dialog: Review Leave (Admin) -->
        <Grid x:Name="ReviewLeaveModal" IsVisible="False" Background="#CC000000">
            <Border Background="#F0141722" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14" Width="460" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="TxtReviewLeaveTitle" Text="Review Leave Request" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock x:Name="TxtReviewLeaveDetails" Text="Employee: John Doe (3 Days)" FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtReviewLeaveReason" Text="Reason: Family emergency" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />

                    <StackPanel Spacing="4" Margin="0,6,0,0">
                        <TextBlock Text="Supervisor Review Comments (Optional)" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtReviewSupervisorComments" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Watermark="e.g. Approved. Please hand over active cases." />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,10,*,10,*" Margin="0,12,0,0">
                        <Button Grid.Column="0" Classes="glass" Content="Cancel" HorizontalAlignment="Stretch" Click="BtnCancelReviewLeave_Click" />
                        <Button Grid.Column="2" Classes="glass" Content="✕ Reject" Foreground="#F87171" HorizontalAlignment="Stretch" Click="BtnConfirmRejectLeave_Click" />
                        <Button Grid.Column="4" Classes="accentGreen" Content="✓ Approve" HorizontalAlignment="Stretch" Click="BtnConfirmApproveLeave_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Glass Modal Dialog: Add Staff Member (Admin) -->
        <Grid x:Name="AddStaffModal" IsVisible="False" Background="#CC000000">
            <Border Background="#F0141722" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14" Width="480" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Add New Team Member" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Create a user profile, set authorization role and work mode" FontSize="11.5" Foreground="#94A3B8" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Full Name" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtAddStaffFullName" Watermark="e.g. Dr. Jane Smith" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Email Address" FontSize="11" Foreground="#94A3B8" />
                            <TextBox x:Name="TxtAddStaffEmail" Watermark="jane@punnya.org" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Username (Optional)" FontSize="11" Foreground="#94A3B8" />
                            <TextBox x:Name="TxtAddStaffUsername" Watermark="jsmith" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Initial Password" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtAddStaffPassword" Watermark="Temporary password" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Authorization Role" FontSize="11" Foreground="#94A3B8" />
                            <ComboBox x:Name="CmbAddStaffRole" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="EMPLOYEE" Tag="EMPLOYEE" />
                                <ComboBoxItem Content="MANAGER" Tag="MANAGER" />
                                <ComboBoxItem Content="ADMIN" Tag="ADMIN" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Work Mode" FontSize="11" Foreground="#94A3B8" />
                            <ComboBox x:Name="CmbAddStaffWorkMode" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="IN_OFFICE" Tag="IN_OFFICE" />
                                <ComboBoxItem Content="REMOTE_WFH" Tag="REMOTE_WFH" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Station Identifier (Optional)" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtAddStaffStationId" Watermark="e.g. ST-CARDIAC-01" />
                    </StackPanel>

                    <TextBlock x:Name="TxtAddStaffError" Text="" FontSize="11" Foreground="#EF4444" IsVisible="False" />

                    <Grid ColumnDefinitions="*,10,*" Margin="0,10,0,0">
                        <Button Grid.Column="0" Classes="glass" Content="Cancel" HorizontalAlignment="Stretch" Click="BtnCancelAddStaff_Click" />
                        <Button Grid.Column="2" Classes="primary" Content="Create Member ✓" HorizontalAlignment="Stretch" Click="BtnSubmitAddStaff_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Floating Glass Notification Toast -->
        <Border x:Name="NotificationToast" IsVisible="False" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,55,20,0" Background="#E6161A26" BorderBrush="#E11D48" BorderThickness="1.5" CornerRadius="10" Padding="12" MaxWidth="360">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="TxtToastIcon" Text="🏖️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtToastTitle" Text="Status Updated" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock x:Name="TxtToastMessage" Text="Your request was updated." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Classes="glass" Content="✕" Padding="6,2" VerticalAlignment="Top" Margin="6,0,0,0" Click="BtnDismissToast_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
